#include "Resource.h"
#include <afxres.h>

IDD_TRAINER_DIALOG DIALOGEX 0, 0, 430, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Species Model Trainer"
FONT 9, "Segoe UI"
BEGIN
	LTEXT           "Dataset export:", IDC_STATIC, 8, 10, 90, 12
	EDITTEXT        IDC_DATASET_PATH, 8, 24, 330, 14, ES_AUTOHSCROLL
	PUSHBUTTON      "Browse...", IDC_BROWSE_DATASET, 344, 23, 76, 16
	LTEXT           "Output ONNX model:", IDC_STATIC, 8, 48, 110, 12
	EDITTEXT        IDC_OUTPUT_PATH, 8, 62, 330, 14, ES_AUTOHSCROLL
	PUSHBUTTON      "Browse...", IDC_BROWSE_OUTPUT, 344, 61, 76, 16
	LTEXT           "Epochs:", IDC_STATIC, 8, 88, 42, 12
	EDITTEXT        IDC_EPOCHS, 52, 86, 48, 14, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT           "Batch size:", IDC_STATIC, 118, 88, 55, 12
	EDITTEXT        IDC_BATCH_SIZE, 174, 86, 48, 14, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT           "Training log:", IDC_STATIC, 8, 112, 80, 12
	EDITTEXT        IDC_LOG, 8, 128, 412, 126, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER
	LTEXT           "Ready", IDC_STATUS, 8, 263, 240, 14
	PUSHBUTTON      "Start training", IDC_START_TRAINING, 248, 260, 82, 20
	PUSHBUTTON      "Stop", IDC_STOP_TRAINING, 338, 260, 82, 20, WS_DISABLED
END