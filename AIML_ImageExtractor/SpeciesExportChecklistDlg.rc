#include "SpeciesExportChecklistDlgResource.h"
#include <winres.h>

IDD_EXPORT_SPECIES_DIALOG DIALOGEX 0, 0, 290, 245
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select species to export"
FONT 9, "Segoe UI"
BEGIN
	LTEXT           "Species are ordered by stored entries (fewest first):", -1, 8, 8, 274, 12
	LISTBOX         IDC_EXPORT_SPECIES_LIST, 8, 24, 274, 174, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
	PUSHBUTTON      "Select all", IDC_EXPORT_SPECIES_SELECT_ALL, 8, 204, 58, 16
	PUSHBUTTON      "Select none", IDC_EXPORT_SPECIES_SELECT_NONE, 72, 204, 66, 16
	DEFPUSHBUTTON   "Export", IDOK, 178, 220, 48, 18
	PUSHBUTTON      "Cancel", IDCANCEL, 234, 220, 48, 18
END
